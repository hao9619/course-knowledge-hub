# 复制为 course.env 后按需填写。不配置模型也可使用知识管理与检索。
COURSE_PORT=8210
COURSE_MODEL_PROVIDER=
# OpenAI 兼容接口：基础 URL 通常以 /v1 结尾，程序追加 /chat/completions
COURSE_MODEL_URL=
COURSE_MODEL_KEY=
COURSE_MODEL_NAME=
# 如使用服务器上另行安装并登录的 Codex CLI，设置 COURSE_MODEL_PROVIDER=codex
COURSE_CODEX_MODEL=gpt-5.6-luna
COURSE_CODEX_REASONING=low
